@startuml ReSport_AI_UserFlow
title ReSport AI — путь пользователя

skinparam shadowing false
skinparam ActivityBackgroundColor #F7F9FC
skinparam ActivityDiamondBackgroundColor #FFF6E5

start

:/start;
if (consent_version актуальна?) then (нет)
  :Дисклеймер: «не медицинская помощь,\nне ставит диагнозы»;
  :Согласие -> users.consent_version, consent_at;
else (да)
endif

:Выбор вида спорта\n(футбол / баскетбол);
:Свободное описание проблемы (текст);

:**llm.classify_complaint**\n-> {scenario_id | "unknown", confidence, body_part};
if (unknown или confidence < threshold?) then (да)
  :Fallback: выбор сценария кнопками;
else (нет)
endif

:sessions INSERT\n(sport, scenario_id, scenario_version, status=in_progress);

repeat
  :engine.next_question(session);
  if (пользователь ответил текстом?) then (да)
    :**llm.normalize_answer**\n-> option_id | "unclear";
    if (unclear?) then (да)
      :Переспрос кнопками\nsource=button;
    else (нет)
      :source=llm;
    endif
  else (нет — кнопка)
    :option_id из callback_data\nsource=button;
  endif
  :session_answers INSERT\n(question_key, raw_text, option_id, source);

  if (engine.check_red_flags() сработал?) then (да)
    #FFE5E5:triage_results INSERT\noutcome=refer_specialist\ntriggered_flags=[...];
    :**llm.explain_step** -> человеческое объяснение;
    #FFE5E5:Сообщение + кнопка\n«Обратиться к специалисту»;
    stop
  else (нет)
  endif
repeat while (остались вопросы?) is (да) not (нет)

:engine.route(answers);

switch (outcome?)
case (refer_specialist)
  #FFE5E5:triage_results INSERT\n+ reason_codes;
  :**llm.explain_step**;
  #FFE5E5:Сообщение + кнопка\n«Обратиться к специалисту»;
  stop
case (recovery_plan)
  :recovery_plans INSERT\nplan_snapshot (jsonb), current_stage=0;
  :sessions.status=plan_active;
endswitch

:Показать текущий этап + задачи;
:Спросить удобное время напоминания\n-> users.reminder_time;

repeat
  :**worker**: напоминание в reminder_time;
  :Чек-ин: отметки задач + состояние\n(лучше / без изменений / хуже);
  :checkins INSERT\n(date, feeling, tasks_done, note);

  if (feeling=worse 2 раза подряд\nили stage.escalate_if?) then (да)
    #FFE5E5:Эскалация -> refer_specialist\nrecovery_plans.status=escalated;
    #FFE5E5:Сообщение + кнопка\n«Обратиться к специалисту»;
    stop
  else (нет)
  endif

  if (выполнены stage.advance_if?) then (да)
    :current_stage += 1\nstage_started_at=now();
    :Показать новый этап;
  else (нет)
  endif
repeat while (этапы остались?) is (да) not (нет)

#E5FFE9:План завершён\nrecovery_plans.status=completed;
:Итоговое сообщение:\nкритерии возврата к нагрузкам\n+ когда всё же идти к специалисту;
stop

@enduml
