# --- приложение ---
APP_ENV=local
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_LOG_JSON=false
APP_PORT=8000

# --- telegram ---
BOT_TOKEN=
BOT_USE_POLLING=true
BOT_WEBHOOK_BASE_URL=https://example.com
BOT_WEBHOOK_SECRET=change-me
BOT_ADMIN_TG_IDS=

# --- postgres ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=resport
DB_PASSWORD=resport
DB_NAME=resport
DB_ECHO=false

# --- redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- llm ---
# provider: null | anthropic | openai | dslab | gigachat
LLM_PROVIDER=null
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=2
LLM_CLASSIFY_CONFIDENCE_THRESHOLD=0.6
LLM_ENABLED_TASKS=classify_complaint,normalize_answer,explain_step

# --- контент (даёт заказчик) ---
CONTENT_CONSENT_VERSION=2026-01-15
CONTENT_SPECIALIST_URL=https://t.me/resport_support
CONTENT_SUPPORT_CONTACT=@resport_support
CONTENT_DEFAULT_REMINDER_TIME=19:00
CONTENT_DEFAULT_TIMEZONE=Europe/Moscow
