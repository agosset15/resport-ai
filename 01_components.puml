@startuml ReSport_AI_Components
title ReSport AI — компонентная схема MVP

skinparam componentStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #444444
skinparam package {
  BorderColor #999999
  FontStyle bold
}

actor "Спортсмен" as User
cloud "Telegram Bot API" as TG
cloud "LLM provider\nOpenAI / Anthropic / GigaChat" as LLMAPI

package "apps" #F2F6FF {
  component "**bot**\naiogram 3\nhandlers · keyboards · renderers\nmiddlewares (ctx, throttle)" as Bot
  component "**api**\nFastAPI\nwebhook · healthz\nMini App API (позже)" as Api
  component "**worker**\nAPScheduler\nнапоминания · эскалации\nежедневные чек-ины" as Worker
}

package "core" #F2FFF4 {
  component "**services**\nTriageService\nTrackerService\nUserService" as Services
  component "**scenarios**\nengine · loader\nnext_question / route / red_flags" as Engine
  component "**llm**\nprovider (Protocol)\ntasks · schemas (pydantic)" as LLM
  component "**domain**\nentities · value objects\nбез I/O" as Domain
}

package "infra" #FFF9F0 {
  component "**repositories**\nSQLAlchemy 2.0 async" as Repo
  component "**telemetry**\nstructlog · OTel\ncontextvars binding" as Tele
  database "PostgreSQL 16" as PG
  database "Redis\nFSM cache · rate limit\nLLM response cache" as Redis
}

folder "scenarios/defs/**/*.yaml\nfootball.ankle_sprain\nbasketball.patellar_pain" as YAML

package "ops" #F7F7F7 {
  component "Metabase\nворонка · retention" as Metabase
  component "Alembic\nмиграции" as Alembic
}

User --> TG
TG --> Api : POST /webhook/{secret}
Api --> Bot : Dispatcher.feed_update()
Bot --> Services : команды и callback'и
Worker --> Services : cron-задачи

Services --> Engine
Services --> LLM
Services --> Repo
Services --> Domain
Engine --> Domain
Engine ..> YAML : load + JSON Schema\nвалидация на старте
LLM --> LLMAPI : structured output\ntimeout 8s, retry x2
LLM ..> Repo : запись llm_calls

Repo --> PG
Alembic --> PG
Bot --> Redis : FSM (кэш)
LLM --> Redis : кэш ответов
Metabase --> PG : read-only

Bot ..> Tele
Services ..> Tele
Repo ..> Tele

note right of Engine
  Источник истины по маршрутизации.
  Детерминирован. LLM не влияет
  на outcome (refer_specialist /
  recovery_plan).
end note

note right of Bot
  Транспортный адаптер.
  Не содержит бизнес-логики —
  заменяется на Mini App
  без правок в core.
end note

note bottom of PG
  FSM-состояние опроса дублируется
  в sessions/session_answers.
  Потеря Redis не теряет прогресс.
end note

@enduml
