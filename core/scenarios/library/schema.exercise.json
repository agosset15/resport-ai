{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resport.ai/schemas/exercises.json",
  "title": "ReSport AI exercise library",
  "type": "object",
  "required": ["version", "exercises"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/exercise"}
    }
  },
  "$defs": {
    "exercise": {
      "type": "object",
      "required": ["id", "title", "instruction", "dosage", "body_region", "phase"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "title": {"type": "string", "minLength": 1},
        "instruction": {
          "type": "string",
          "minLength": 1,
          "description": "понятная инструкция без медицинского жаргона"
        },
        "lookup_hint": {
          "type": "string",
          "minLength": 1,
          "description": "подсказка посмотреть упражнение в интернете; по умолчанию собирается из названия"
        },
        "dosage": {"$ref": "#/$defs/dosage"},
        "body_region": {
          "enum": [
            "ankle_foot",
            "knee",
            "thigh_front",
            "thigh_back",
            "groin",
            "hand_finger",
            "general"
          ]
        },
        "phase": {"enum": ["acute", "subacute", "return"]},
        "limits": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "description": "ограничения: до какой боли, чего не делать"
        },
        "equipment": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "source": {"type": "string", "minLength": 1},
        "review_status": {"enum": ["draft", "approved"]},
        "updated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "dosage": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "sets": {"type": "integer", "minimum": 1, "maximum": 10},
        "reps": {"type": "integer", "minimum": 1, "maximum": 100},
        "duration_seconds": {"type": "integer", "minimum": 5, "maximum": 1800},
        "note": {"type": "string", "minLength": 1}
      },
      "description": "либо подходы с повторениями, либо длительность — проверяется семантикой"
    }
  }
}
