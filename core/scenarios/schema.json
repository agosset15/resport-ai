{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resport.ai/schemas/scenario.json",
  "title": "ReSport AI scenario",
  "type": "object",
  "required": ["id", "version", "sport", "title", "questions", "routing", "texts"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
      "description": "sport.scenario_key, например football.ankle_sprain"
    },
    "version": {"type": "integer", "minimum": 1},
    "sport": {"enum": ["football", "basketball"]},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "entry_hints": {
      "type": "array",
      "items": {"type": "string", "minLength": 2},
      "description": "подсказки для LLM-классификатора и для поиска кнопкой"
    },
    "labels": {
      "type": "object",
      "description": "option_id -> подпись кнопки, если опции заданы строками",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/question"}
    },
    "red_flags": {
      "type": "array",
      "items": {"$ref": "#/$defs/red_flag"}
    },
    "routing": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/routing_rule"}
    },
    "plans": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/plan"}
    },
    "texts": {
      "type": "object",
      "required": ["refer_specialist", "recovery_plan_intro", "escalation"],
      "additionalProperties": false,
      "properties": {
        "refer_specialist": {"type": "string", "minLength": 1},
        "recovery_plan_intro": {"type": "string", "minLength": 1},
        "escalation": {"type": "string", "minLength": 1}
      },
      "description": "статичные фоллбэки на случай недоступности LLM"
    }
  },
  "$defs": {
    "option": {
      "oneOf": [
        {"type": "string", "pattern": "^[a-z0-9_]+$"},
        {
          "type": "object",
          "required": ["id", "label"],
          "additionalProperties": false,
          "properties": {
            "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
            "label": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "question": {
      "type": "object",
      "required": ["key", "text", "options"],
      "additionalProperties": false,
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "text": {"type": "string", "minLength": 1},
        "hint": {"type": "string"},
        "allow_free_text": {"type": "boolean", "default": true},
        "ask_if": {"$ref": "#/$defs/condition"},
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/option"}
        }
      }
    },
    "condition": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}},
        "any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}},
        "not": {"$ref": "#/$defs/condition"},
        "equals": {"type": "string"},
        "in": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": {
        "oneOf": [
          {"type": "string"},
          {"type": "array", "minItems": 1, "items": {"type": "string"}}
        ]
      }
    },
    "red_flag": {
      "type": "object",
      "required": ["id", "question", "when", "outcome", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "question": {"type": "string"},
        "when": {"$ref": "#/$defs/condition"},
        "outcome": {"enum": ["refer_specialist", "recovery_plan"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "routing_rule": {
      "type": "object",
      "required": ["outcome"],
      "additionalProperties": false,
      "properties": {
        "when": {"$ref": "#/$defs/condition"},
        "default": {"type": ["boolean", "null"]},
        "outcome": {"enum": ["refer_specialist", "recovery_plan"]},
        "plan": {"type": "string"},
        "reason_code": {"type": "string"}
      }
    },
    "plan": {
      "type": "object",
      "required": ["title", "stages", "completion_text"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "completion_text": {"type": "string", "minLength": 1},
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/stage"}
        }
      }
    },
    "stage": {
      "type": "object",
      "required": ["key", "title", "days", "tasks", "advance_if"],
      "additionalProperties": false,
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "days": {"type": "integer", "minimum": 1, "maximum": 90},
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key", "text"],
            "additionalProperties": false,
            "properties": {
              "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "text": {"type": "string", "minLength": 1}
            }
          }
        },
        "advance_if": {"$ref": "#/$defs/checkin_condition"},
        "escalate_if": {"$ref": "#/$defs/checkin_condition"}
      }
    },
    "checkin_condition": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "feeling": {
          "oneOf": [
            {"enum": ["better", "same", "worse"]},
            {
              "type": "array",
              "minItems": 1,
              "items": {"enum": ["better", "same", "worse"]}
            }
          ]
        },
        "consecutive": {"type": "integer", "minimum": 1, "maximum": 14},
        "min_days": {"type": "integer", "minimum": 0, "maximum": 90},
        "tasks_done_ratio_gte": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
